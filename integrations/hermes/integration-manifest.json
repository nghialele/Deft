      "native_adapter_suite": "integrations/hermes/deft-platform/test_deft_platform.py"
    }
  },
  "default_adapter": "native",
  "mcp": {
    "default_transport": "direct_http",
    "endpoint_path": "/api/mcp/hermes/v1"
  },
  "adapters": [
    {
      "id": "native",
      "name": "deft-platform",
      "version": "0.2.1",
      "role": "default",
      "kind": "native_platform",
      "protocol": "deft.agent_channel.v2",
      "runtime_capabilities": [
        "autonomous_platform_adapter_v1",
        "accepted_event_rehydration_v1"
      ],
      "mcp_transport": "direct_http",
      "target": "plugins/deft-platform",
      "files": [
        {
          "source": "integrations/hermes/deft-platform/__init__.py",
          "target": "__init__.py"
        },
        {
          "source": "integrations/hermes/deft-platform/adapter.py",
          "target": "adapter.py"
        },
        {
          "source": "integrations/hermes/deft-platform/plugin.yaml",
          "target": "plugin.yaml"
        },
        {
          "source": "integrations/hermes/deft-platform/readiness.py",
          "target": "readiness.py"
        },
        {
          "source": "integrations/hermes/deft-platform/README.md",
          "target": "README.md"
        }
      ]
    },
    {
      "id": "legacy",
      "name": "deft-agent-channel-bridge",
      "version": "0.3.0",
      "role": "fallback",
      "kind": "legacy_bridge",
      "protocol": "deft.agent_channel.v2",
      "runtime_capabilities": [
        "single_flight_claims",
        "renewable_leases",
        "fencing_tokens",
        "terminal_outcomes",
        "identity_bound_mcp",
        "wiki_memory_sync_v1",
        "runtime_reconciliation_v1",
        "runtime_attestation_v1"
      ],
      "mcp_transport": "stdio_shim",
      "target": "legacy/bridge",
      "files": [
        {
          "source": "scripts/hermes-agent-channel-bridge.mjs",
          "target": "hermes-agent-channel-bridge.mjs"
        },
        {
          "source": "scripts/hermes-channel-service.ps1",
          "target": "hermes-channel-service.ps1"
        },
        {
          "source": "scripts/run-hermes-channel-service.ps1",
          "target": "run-hermes-channel-service.ps1"
        },
        {
          "source": "integrations/hermes/deft-mcp-stdio.mjs",
          "target": "deft-mcp-stdio.mjs"
        }
      ]
    }
  ],
  "common_plugins": [
